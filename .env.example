# Copy to .env.local for local development. Never commit real values or secrets —
# MSAL uses PKCE + a public client, so no client secret belongs here (CLAUDE.md §10).
# The redirect URI is not an env var: MSAL uses the app's own origin at runtime.

# Per-microservice base URLs (CLAUDE.md §5: no API gateway yet — each service
# is called directly at its own base URL until deploy/azure fronts them with
# Front Door/APIM). Local values match each *.Api project's launchSettings.json.
VITE_AUDIT_API_URL=http://localhost:5062/api/v1
VITE_FINDING_API_URL=http://localhost:5153/api/v1
VITE_ACTION_PLAN_API_URL=http://localhost:5057/api/v1
VITE_NOTIFICATION_API_URL=http://localhost:5079/api/v1
VITE_REPORTING_API_URL=http://localhost:5026/api/v1

# Entra ID (Microsoft.Identity.Web on the API side; MSAL Browser/React here) —
# placeholders only, see docs/entra-id-setup.md for a real App Registration.
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://REPLACE_WITH_API_APP_ID/access_as_user
