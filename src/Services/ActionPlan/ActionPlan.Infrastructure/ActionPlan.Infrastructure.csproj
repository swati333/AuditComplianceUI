<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ActionPlan.Application\ActionPlan.Application.csproj" />
    <ProjectReference Include="..\ActionPlan.Domain\ActionPlan.Domain.csproj" />
    <ProjectReference Include="..\ActionPlan.Contracts\ActionPlan.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Ehs.EventBus\Ehs.EventBus.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Ehs.Observability\Ehs.Observability.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Ehs.SharedKernel\Ehs.SharedKernel.csproj" />
