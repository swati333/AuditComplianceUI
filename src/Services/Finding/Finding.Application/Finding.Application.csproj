<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Finding.Domain\Finding.Domain.csproj" />
    <ProjectReference Include="..\Finding.Contracts\Finding.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Ehs.SharedKernel\Ehs.SharedKernel.csproj" />
    <!-- IIntegrationEventHandler<T> — this project hosts the Audit-event consumers. -->
