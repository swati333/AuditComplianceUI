<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Finding.Application\Finding.Application.csproj" />
    <ProjectReference Include="..\Finding.Domain\Finding.Domain.csproj" />
    <ProjectReference Include="..\Finding.Contracts\Finding.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Ehs.EventBus\Ehs.EventBus.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Ehs.Observability\Ehs.Observability.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Ehs.SharedKernel\Ehs.SharedKernel.csproj" />
    <!-- Consumed Audit event payload types (contracts only, never AuditDb). -->
    <ProjectReference Include="..\..\Audit\Audit.Contracts\Audit.Contracts.csproj" />
    <!-- Consumed Action Plan event payload types (contracts only, never ActionPlanDb). -->
    <ProjectReference Include="..\..\ActionPlan\ActionPlan.Contracts\ActionPlan.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLAUDE.md §3: EF Core 10 + SQL Server, Code First migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>ehs-finding-service</UserSecretsId>
  </PropertyGroup>

</Project>
